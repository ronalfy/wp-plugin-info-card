{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "version": 2,
    "phpVersion": "8.3",
    "wordpressVersion": "latest",
    "applicationOptions": {
        "wordpress-playground": {
            "landingPage": "/",
            "login": true,
            "networkAccess": true
        }
    },
    "activeTheme": "twentytwentyfive",
    "plugins": [
        "generateblocks",
        "mediaron-block-shortcuts-for-gb",
        "alerts-dlx",
        "slash-edit",
        "wp-plugin-info-card"
    ],
    "contentBaseline": "empty",
    "siteOptions": {
        "blogname": "WP Plugin Info Card Demo",
        "blogdescription": "One plugin to showcase many types of plugin and GitHub cards",
        "timezone_string": "",
        "gmt_offset": "0",
        "date_format": "F j, Y",
        "time_format": "g:i a",
        "start_of_week": "1",
        "permalink_structure": "/%year%/%monthnum%/%postname%/",
        "category_base": "",
        "tag_base": "",
        "default_comment_status": "open",
        "default_ping_status": "open",
        "comment_moderation": "1",
        "comment_previously_approved": "1",
        "comment_max_links": "2",
        "moderation_keys": "",
        "disallowed_keys": "",
        "comment_registration": "",
        "require_name_email": "1",
        "show_comments_cookies_opt_in": "1",
        "thread_comments": "1",
        "thread_comments_depth": "5",
        "page_comments": "",
        "comments_per_page": "50",
        "default_comments_page": "newest",
        "comment_order": "asc",
        "close_comments_for_old_posts": "1",
        "close_comments_days_old": "1",
        "show_avatars": "1",
        "avatar_rating": "G",
        "avatar_default": "mystery",
        "thumbnail_size_w": "150",
        "thumbnail_size_h": "150",
        "thumbnail_crop": "1",
        "medium_size_w": "300",
        "medium_size_h": "300",
        "medium_large_size_w": "768",
        "medium_large_size_h": "0",
        "large_size_w": "1024",
        "large_size_h": "1024",
        "uploads_use_yearmonth_folders": "1",
        "generateblocks_version": "2.5.1"
    },
    "additionalStepsAfterExecution": [
        {
            "step": "importContent",
            "content": [
                {
                    "type": "wxr",
                    "source": "https://github.com/blueprint.wxr",
                    "authorsMode": "map",
                    "authorsMap": {
                        "ronalfy": "admin"
                    },
                    "defaultAuthorUsername": "admin",
                    "urlsMode": "rewrite",
                    "staticAssets": "fetch"
                }
            ]
        },
        {
            "step": "runPHP",
            "code": {
                "filename": "front-page.php",
                "content": "<?php require '/wordpress/wp-load.php'; $page = get_page_by_path( 'front-page', OBJECT, 'page' ); if ( $page instanceof WP_Post ) { update_option( 'page_on_front', (int) $page->ID ); update_option( 'show_on_front', 'page' ); }"
            }
        },
        {
            "step": "setSiteOptions",
            "options": {
                "theme_mods_twentytwentyfive": {
                    "custom_css_post_id": -1
                },
                "wppic_plugin_generateblocks": {
                    "url": "https://wordpress.org/plugins/generateblocks/",
                    "name": "GenerateBlocks",
                    "slug": "generateblocks",
                    "version": "2.5.1",
                    "author": "Tom",
                    "author_profile": "https://profiles.wordpress.org/edge22/",
                    "contributors": "edge22",
                    "tested": "7.1.4",
                    "requires": "6.7",
                    "rating": 98,
                    "num_ratings": 122,
                    "ratings": {
                        "5": 115,
                        "4": 1,
                        "3": 4,
                        "2": 0,
                        "1": 2
                    },
                    "downloaded": 200000,
                    "active_installs": 200000,
                    "last_updated_human_time": "6 days",
                    "last_updated": "2026-11-10 2:44pm GMT",
                    "last_updated_mk": "2026-11-10 2:44pm GMT",
                    "added": "2020-05-19",
                    "homepage": "https://generateblocks.com",
                    "short_description": "A small collection of lightweight WordPress blocks that can accomplish nearly anything.",
                    "download_link": "https://downloads.wordpress.org/plugin/generateblocks.2.5.1.zip",
                    "donate_link": "https://generatepress.com",
                    "icons": {
                        "1x": "https://ps.w.org/generateblocks/assets/icon.svg?rev=3744275",
                        "svg": "https://ps.w.org/generateblocks/assets/icon.svg?rev=3744275"
                    },
                    "banners": {
                        "low": "https://ps.w.org/generateblocks/assets/banner-772x250.png?rev=3744275",
                        "high": "https://ps.w.org/generateblocks/assets/banner-1544x500.png?rev=3744275"
                    },
                    "screenshots": [],
                    "is_edd": false,
                    "review_url": "",
                    "requires_php": "7.2"
                },
                "wppic_settings": {
                    "default_layout": "card",
                    "colorscheme": "default",
                    "widget": false,
                    "ajax": false,
                    "enqueue": false,
                    "credit": false,
                    "cache_expiration": "3600",
                    "ping_rest_api_interval": "14",
                    "enable_screenshots": "1",
                    "enable_local_screenshots": "",
                    "skip_animated_gifs": "1",
                    "enable_local_screenshots_download_missing": "",
                    "enable_local_screenshots_keep_current": "",
                    "enable_local_screenshots_cli_command": "",
                    "screenshots_table_version": "0.0.0",
                    "enable_edd": false,
                    "edd_default_icon_id": "0",
                    "edd_default_banner_id": "0",
                    "edd_default_icon_url": "",
                    "edd_default_banner_url": "",
                    "enable_rest_api": false,
                    "enable_custom_plugins": true,
                    "enable_github_info_cards": true,
                    "github_info_cards_token": "",
                    "github_info_cards_unauthenticated": true,
                    "github_info_cards_rate_limit": "60",
                    "github_info_cards_rate_remaining": "60",
                    "github_info_cards_rate_reset": "1794863772"
                }
            }
        }
    ]
}